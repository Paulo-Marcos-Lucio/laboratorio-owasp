<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
          3.3.4 (set/2024) trazia spring-security-crypto 6.3.3, afetado pela CVE-2025-22228:
          BCryptPasswordEncoder.matches() devolvia true para uma senha ERRADA sempre que os
          72 primeiros bytes coincidiam. Isso quebrava justamente o lado "corrigido" da licao
          de senha. A partir de 6.3.8/6.4.4 a CVE esta fechada; a linha 3.5.x ja trazia 6.5.x,
          que recusa a senha longa no encode. Ver HashSenhaTest.
          4.1.0 e salto de major (Spring Boot 4 / Spring Framework 7, PR #7 do Dependabot,
          bump do grupo maven). Nao muda nenhuma licao: o repo nao usa Spring Security como
          framework (so spring-security-crypto, uma lib isolada), so MockMvc/MockBean nos
          testes. A subida exigiu duas mudancas mecanicas de infraestrutura de teste:
          spring-boot-starter-web -> spring-boot-starter-webmvc (o antigo starter foi
          descontinuado) e a adicao de spring-boot-starter-webmvc-test, porque o Boot 4
          tirou o suporte a MockMvc de dentro de spring-boot-test-autoconfigure e moveu para
          um modulo proprio por tecnologia web. @AutoConfigureMockMvc mudou de pacote
          (org.springframework.boot.test.autoconfigure.web.servlet ->
          org.springframework.boot.webmvc.test.autoconfigure) e @MockBean foi removido em
          favor de @MockitoBean (org.springframework.test.context.bean.override.mockito),
          que ja era o substituto recomendado desde o 3.4. Validado rodando `verify`
          (49 testes verdes).
        -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>br.com.paulomarcos</groupId>
    <artifactId>laboratorio-owasp</artifactId>
    <version>0.4.0</version>
    <name>laboratorio-owasp</name>
    <description>Laboratorio didatico com 8 vulnerabilidades em 3 das 10 categorias do OWASP Top 10:2025 (A01, A04, A05) — vulneravel, exploit e corrigido, em Spring Boot.</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spotless.version>3.9.0</spotless.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 tirou o suporte a MockMvc (@AutoConfigureMockMvc) de dentro de
          spring-boot-starter-test e passou a exigir este starter à parte, um por
          tecnologia web. Sem ele o @SpringBootTest sobe mas MockMvc some do contexto.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              O unico portao de estilo do repo. Os 4 repos Python da suite gateiam
              ruff check, ruff format e mypy em modo estrito; este era o unico sem nada,
              e a deriva ja tinha acontecido (duas convencoes de @Autowired, 4 linhas
              acima de 100 colunas).
              `mvn verify` reprova o build se a formatacao sair do padrao;
              `mvn spotless:apply` conserta.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      Desliga o cache de DNS da JVM (padrao ~30s). Sem isso o
                      SsrfLimiteRebindingTest nao consegue demonstrar o DNS rebinding
                      dentro de uma unica requisicao: a segunda resolucao viria do cache.
                      Nenhum teste faz DNS de verdade, entao o custo e zero.
                    -->
                    <argLine>@{argLine} -Dsun.net.inetaddr.ttl=0</argLine>
                </configuration>
            </plugin>
            <!--
              JaCoCo MEDE a cobertura e emite o relatorio (target/site/jacoco), mas NAO
              gateia por linha — coerente com a decisao registrada no README: o portao que
              importa aqui e a prova exploit x correcao, nao a %. O @{argLine} acima injeta
              o agente do JaCoCo sem sobrescrever o -Dsun.net.inetaddr.ttl=0 do rebinding.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepara-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>relatorio</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
